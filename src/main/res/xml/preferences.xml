<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Home Screen Grid">

        <SwitchPreference
            android:key="home_grid_8x4"
            android:title="Custom Home Grid"
            android:summary="Enable LiquidDock home-screen grid sizing"
            android:defaultValue="false" />

        <ListPreference
            android:key="grid_profile"
            android:title="Grid Layout"
            android:entries="@array/home_grid_profile_entries"
            android:entryValues="@array/home_grid_profile_values"
            android:defaultValue="8x4"
            android:summary="%s"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_landscape_margin_left"
            android:title="Landscape Grid Left Margin"
            android:summary="%d px"
            android:defaultValue="160"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_landscape_margin_right"
            android:title="Landscape Grid Right Margin"
            android:summary="%d px"
            android:defaultValue="160"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_landscape_margin_top"
            android:title="Landscape Grid Top Margin"
            android:summary="%d px"
            android:defaultValue="80"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_landscape_margin_bottom"
            android:title="Landscape Grid Bottom Margin"
            android:summary="%d px"
            android:defaultValue="80"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_portrait_margin_left"
            android:title="Portrait Grid Left Margin"
            android:summary="%d px"
            android:defaultValue="80"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_portrait_margin_right"
            android:title="Portrait Grid Right Margin"
            android:summary="%d px"
            android:defaultValue="80"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_portrait_margin_top"
            android:title="Portrait Grid Top Margin"
            android:summary="%d px"
            android:defaultValue="160"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="grid_portrait_margin_bottom"
            android:title="Portrait Grid Bottom Margin"
            android:summary="%d px"
            android:defaultValue="160"
            app:min="0"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="indicator_landscape_x"
            android:title="Landscape Indicator X Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="-400"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="indicator_landscape_y"
            android:title="Landscape Indicator Y Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="-400"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="indicator_portrait_x"
            android:title="Portrait Indicator X Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="-400"
            app:max="400"
            android:dependency="home_grid_8x4" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="indicator_portrait_y"
            android:title="Portrait Indicator Y Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="-400"
            app:max="400"
            android:dependency="home_grid_8x4" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Dock Appearance">

        <SwitchPreference
            android:key="dock_customization"
            android:title="Customize Entire Dock"
            android:summary="Master switch for all LiquidDock Dock appearance, shadow, spacing and offset hooks"
            android:defaultValue="true" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="blur_radius"
            android:title="Blur Radius"
            android:summary="%d"
            android:defaultValue="100"
            app:min="0"
            app:max="400" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="height_offset"
            android:title="Height Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="-200"
            app:max="200" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="width_offset"
            android:title="Width Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="-200"
            app:max="200" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="corner_offset"
            android:title="Stroke Corner Offset"
            android:summary="%d px"
            android:defaultValue="-1"
            app:min="-50"
            app:max="100" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="blur_corner_offset"
            android:title="Blur Background Corner Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="-50"
            app:max="100" />

        <SwitchPreference
            android:key="dock_stroke"
            android:title="Dock Stroke"
            android:summary="Draw the complete Dock border and lighting"
            android:defaultValue="true" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="stroke_base_r"
            android:title="Stroke Base Red"
            android:summary="%d"
            android:defaultValue="255"
            app:min="0"
            app:max="255"
            android:dependency="dock_stroke" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="stroke_base_g"
            android:title="Stroke Base Green"
            android:summary="%d"
            android:defaultValue="255"
            app:min="0"
            app:max="255"
            android:dependency="dock_stroke" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="stroke_base_b"
            android:title="Stroke Base Blue"
            android:summary="%d"
            android:defaultValue="255"
            app:min="0"
            app:max="255"
            android:dependency="dock_stroke" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="stroke_base_alpha"
            android:title="Stroke Base Alpha"
            android:summary="%d"
            android:defaultValue="255"
            app:min="0"
            app:max="255"
            android:dependency="dock_stroke" />

        <SwitchPreference
            android:key="squircle"
            android:title="Squircle Corners"
            android:summary="iOS-style continuous curve"
            android:defaultValue="false" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="sq_stroke_w"
            android:title="Squircle Stroke Width"
            android:summary="%d px"
            android:defaultValue="4"
            app:min="1"
            app:max="20"
            android:dependency="squircle" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="sq_stroke_off"
            android:title="Squircle Stroke Offset"
            android:summary="%d px"
            android:defaultValue="8"
            app:min="0"
            app:max="30"
            android:dependency="squircle" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="sq_outer_cp"
            android:title="Squircle Outer CP"
            android:summary="%d"
            android:defaultValue="58"
            app:min="40"
            app:max="80"
            android:dependency="squircle" />

        <SwitchPreference
            android:key="fill_diff"
            android:title="Fill-Diff Stroke"
            android:summary="Crisp anti-alias via fill+punch"
            android:defaultValue="false" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="stroke_w"
            android:title="Fill-Diff Width"
            android:summary="%d px"
            android:defaultValue="2"
            app:min="1"
            app:max="10"
            android:dependency="fill_diff" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="std_stroke_w"
            android:title="Stroke Thickness"
            android:summary="%d px"
            android:defaultValue="4"
            app:min="1"
            app:max="20" />

        <SwitchPreference
            android:key="dock_shadow"
            android:title="Dock Drop Shadow"
            android:summary="External shadow below the whole Dock"
            android:defaultValue="true" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="dock_shadow_radius"
            android:title="Drop Shadow Softness"
            android:summary="%d px"
            android:defaultValue="42"
            app:min="1"
            app:max="80"
            android:dependency="dock_shadow" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="dock_shadow_size"
            android:title="Drop Shadow Size"
            android:summary="Maximum %d px beyond Dock"
            android:defaultValue="52"
            app:min="1"
            app:max="120"
            android:dependency="dock_shadow" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="dock_shadow_alpha"
            android:title="Drop Shadow Alpha"
            android:summary="%d"
            android:defaultValue="140"
            app:min="0"
            app:max="200"
            android:dependency="dock_shadow" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="dock_shadow_y"
            android:title="Drop Shadow Y Offset"
            android:summary="%d px"
            android:defaultValue="12"
            app:min="-40"
            app:max="40"
            android:dependency="dock_shadow" />

        <SwitchPreference
            android:key="stroke_shadow"
            android:title="Stroke Shadow"
            android:summary="Soft inner shadow below the border"
            android:defaultValue="true" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="shadow_radius"
            android:title="Shadow Radius"
            android:summary="%d px"
            android:defaultValue="8"
            app:min="1"
            app:max="40"
            android:dependency="stroke_shadow" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="shadow_alpha"
            android:title="Shadow Alpha"
            android:summary="%d"
            android:defaultValue="70"
            app:min="0"
            app:max="200"
            android:dependency="stroke_shadow" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="dock_spacing"
            android:title="Dock Icon Spacing"
            android:summary="%d px each side"
            android:defaultValue="0"
            app:min="-10"
            app:max="20" />

        <com.hellovoid.liquiddock.SeekBarPreference
            android:key="dock_bottom_offset"
            android:title="Dock Bottom Offset"
            android:summary="%d px"
            android:defaultValue="0"
            app:min="0"
            app:max="80" />

    </PreferenceCategory>


    <PreferenceCategory android:title="Dock Divider">
        <SwitchPreference
            android:key="dock_divider_enabled"
            android:title="Customize Dock Divider"
            android:summary="Independent from Dock size, blur and unit settings"
            android:defaultValue="false" />
        <com.hellovoid.liquiddock.SeekBarPreference android:key="dock_divider_width_dp"
            android:title="Divider Width (0.1 dp)" android:summary="%d × 0.1 dp"
            android:defaultValue="10" app:min="0" app:max="160" android:dependency="dock_divider_enabled" />
        <com.hellovoid.liquiddock.SeekBarPreference android:key="dock_divider_height_scale"
            android:title="Divider Height" android:summary="%d%%"
            android:defaultValue="60" app:min="0" app:max="100" android:dependency="dock_divider_enabled" />
        <com.hellovoid.liquiddock.SeekBarPreference android:key="dock_divider_y_offset"
            android:title="Divider Y Offset (0.1 dp)" android:summary="%d × 0.1 dp"
            android:defaultValue="0" app:min="-80" app:max="80" android:dependency="dock_divider_enabled" />
        <com.hellovoid.liquiddock.SeekBarPreference android:key="dock_divider_color_r"
            android:title="Divider Red" android:summary="%d" android:defaultValue="255"
            app:min="0" app:max="255" android:dependency="dock_divider_enabled" />
        <com.hellovoid.liquiddock.SeekBarPreference android:key="dock_divider_color_g"
            android:title="Divider Green" android:summary="%d" android:defaultValue="255"
            app:min="0" app:max="255" android:dependency="dock_divider_enabled" />
        <com.hellovoid.liquiddock.SeekBarPreference android:key="dock_divider_color_b"
            android:title="Divider Blue" android:summary="%d" android:defaultValue="255"
            app:min="0" app:max="255" android:dependency="dock_divider_enabled" />
        <com.hellovoid.liquiddock.SeekBarPreference android:key="dock_divider_alpha"
            android:title="Divider Alpha" android:summary="%d" android:defaultValue="128"
            app:min="0" app:max="255" android:dependency="dock_divider_enabled" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Backup &amp; Restore">

        <Preference
            android:key="export_config"
            android:title="Export Current Parameters"
            android:summary="Save all LiquidDock settings as JSON"
            android:icon="@android:drawable/ic_menu_save" />

        <Preference
            android:key="import_config"
            android:title="Import Parameters"
            android:summary="Validate and apply a LiquidDock JSON file"
            android:icon="@android:drawable/ic_menu_upload" />

    </PreferenceCategory>

    <Preference
        android:key="preset_ipad"
        android:title="Apply iPad Preset"
        android:summary="Calculated from MIUI Home dimensions and this display"
        android:icon="@android:drawable/ic_menu_manage" />
    <PreferenceCategory android:title="@string/category_about">
        <SwitchPreference
            android:key="liquiddock_debug_log"
            android:title="@string/pref_debug_log"
            android:summary="@string/pref_debug_log_summary"
            android:defaultValue="false" />
        <Preference
            android:key="restart_launcher"
        android:title="Restart Launcher"
        android:summary="Apply changes"
        android:icon="@android:drawable/ic_menu_rotate" />
    </PreferenceCategory>

</PreferenceScreen>
