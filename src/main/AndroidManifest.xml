<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.miui.home" />
        <package android:name="com.android.systemui" />
    </queries>

    <application
        android:name=".LiquidDockApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true">
        <activity
            android:name=".ComposeSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.LiquidDock"
            android:label="LiquidDock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".FreeformLeashBrokerService"
            android:exported="true" />
    </application>
</manifest>
